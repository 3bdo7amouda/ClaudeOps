terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    # Replace all PLACEHOLDER values before use
    bucket         = "PLACEHOLDER-terraform-state"
    key            = "PLACEHOLDER-service/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "PLACEHOLDER-terraform-locks"
    encrypt        = true
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}
